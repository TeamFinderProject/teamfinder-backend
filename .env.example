# Скопируйте в .env (он в .gitignore) и задайте свои значения.
POSTGRES_PASSWORD=teamfinder_local
# Не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SIGNING_KEY=

# Демо-данные для показа: true — создать пользователей ivan/petr/anna/maria@demo.local (пароль Demo12345!)
DEMO_SEED=true

# Telegram-бот (необязательно). Создать бота: написать @BotFather -> /newbot.
# Токен вида 1234567890:AA... и имя бота без @. Если оставить пустым — уведомления только на сайте.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
